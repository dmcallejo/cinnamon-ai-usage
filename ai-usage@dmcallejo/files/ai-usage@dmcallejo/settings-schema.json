{
    "layout": {
        "type": "layout",
        "pages": [
            "general-page",
            "providers-page"
        ],
        "general-page": {
            "type": "page",
            "title": "General",
            "sections": [
                "panel-section",
                "refresh-section",
                "alerts-section"
            ]
        },
        "providers-page": {
            "type": "page",
            "title": "Providers",
            "sections": [
                "anthropic-section",
                "codex-section"
            ]
        },
        "panel-section": {
            "type": "section",
            "title": "Panel",
            "keys": [
                "panel-display",
                "show-reset-in-panel",
                "show-extra-usage"
            ]
        },
        "refresh-section": {
            "type": "section",
            "title": "Updates",
            "keys": [
                "refresh-interval"
            ]
        },
        "alerts-section": {
            "type": "section",
            "title": "Alerts",
            "keys": [
                "warning-threshold",
                "critical-threshold",
                "notify-critical"
            ]
        },
        "anthropic-section": {
            "type": "section",
            "title": "Claude (Anthropic)",
            "keys": [
                "anthropic-mode",
                "anthropic-credentials-path",
                "anthropic-help"
            ]
        },
        "codex-section": {
            "type": "section",
            "title": "Codex (OpenAI)",
            "keys": [
                "codex-mode",
                "codex-auth-path",
                "codex-help"
            ]
        }
    },
    "panel-display": {
        "type": "combobox",
        "default": "highest",
        "description": "Panel text",
        "options": {
            "Highest usage": "highest",
            "Main limit of each provider": "primary",
            "All limits": "all",
            "Icon only": "icon"
        },
        "tooltip": "Which percentages to show next to the icon. The menu always shows every limit."
    },
    "show-reset-in-panel": {
        "type": "switch",
        "default": true,
        "description": "Show time until reset in the panel",
        "tooltip": "Only shown when the panel displays a single limit.",
        "dependency": "panel-display!=icon"
    },
    "show-extra-usage": {
        "type": "switch",
        "default": true,
        "description": "Show extra usage spending in the menu",
        "tooltip": "Pay-as-you-go credits used after the plan limits are reached, when your plan has them enabled."
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "minutes",
        "description": "Refresh every"
    },
    "warning-threshold": {
        "type": "spinbutton",
        "default": 75,
        "min": 1,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Warning level"
    },
    "critical-threshold": {
        "type": "spinbutton",
        "default": 90,
        "min": 1,
        "max": 100,
        "step": 1,
        "units": "%",
        "description": "Critical level"
    },
    "notify-critical": {
        "type": "switch",
        "default": true,
        "description": "Send a notification when a limit reaches the critical level"
    },
    "anthropic-mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Show Claude usage",
        "options": {
            "When signed in": "auto",
            "Always": "on",
            "Never": "off"
        },
        "tooltip": "\"When signed in\" shows Claude only if a Claude Code sign-in is found."
    },
    "anthropic-credentials-path": {
        "type": "entry",
        "default": "",
        "description": "Claude Code credentials file",
        "tooltip": "Leave empty to use $CLAUDE_CONFIG_DIR/.credentials.json or ~/.claude/.credentials.json.",
        "dependency": "anthropic-mode!=off"
    },
    "anthropic-help": {
        "type": "label",
        "description": "Uses the sign-in stored by Claude Code. It is read only and never sent anywhere except api.anthropic.com.",
        "dependency": "anthropic-mode!=off"
    },
    "codex-mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Show Codex usage",
        "options": {
            "When signed in": "auto",
            "Always": "on",
            "Never": "off"
        },
        "tooltip": "\"When signed in\" shows Codex only if a Codex CLI sign-in is found. These are the Codex limits of your ChatGPT plan; ChatGPT chat message limits are not available."
    },
    "codex-auth-path": {
        "type": "entry",
        "default": "",
        "description": "Codex CLI credentials file",
        "tooltip": "Leave empty to use $CODEX_HOME/auth.json or ~/.codex/auth.json.",
        "dependency": "codex-mode!=off"
    },
    "codex-help": {
        "type": "label",
        "description": "Uses the sign-in stored by the Codex CLI. It is read only and never sent anywhere except chatgpt.com.",
        "dependency": "codex-mode!=off"
    }
}
