#: applet.js:82
msgid "AI usage limits"
msgstr "Límites de uso de IA"

#: applet.js:92 applet.js:438
msgid "Refresh now"
msgstr "Actualizar ahora"

#: applet.js:249
#, javascript-format
msgid "Could not reach %s. Check your connection."
msgstr "No se pudo contactar con %s. Revisa tu conexión."

