msgstr "Sesión actual"

#: providers/anthropic.js:32
msgid "Weekly, all models"
msgstr "Semanal, todos los modelos"

#: providers/anthropic.js:34
msgid "Weekly, Opus"
msgstr "Semanal, Opus"

#: providers/anthropic.js:36
