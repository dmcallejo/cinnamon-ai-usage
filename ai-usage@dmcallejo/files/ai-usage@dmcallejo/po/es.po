msgstr "%s de %s"

#: applet.js:562
msgid "Loading..."
msgstr "Cargando..."

#: applet.js:570
#, javascript-format
msgid "Open %s usage page"
msgstr "Abrir la página de uso de %s"

#: applet.js:581
#, javascript-format
