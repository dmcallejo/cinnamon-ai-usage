msgstr "Semanal, Sonnet"

#: providers/anthropic.js:92 providers/anthropic.js:108
msgid "Extra usage"
msgstr "Uso adicional"

#: providers/anthropic.js:181
#, javascript-format
msgid "No Claude Code sign-in found at %s. Sign in with Claude Code first."
msgstr ""
"No se encontró ninguna sesión de Claude Code en %s. Inicia sesión primero "
"con Claude Code."

#: providers/anthropic.js:184
#, javascript-format
msgid "Could not parse %s."
msgstr "No se pudo leer %s."

#: providers/anthropic.js:191
#, javascript-format
msgid ""
"No Claude subscription sign-in found in %s. API keys do not have plan "
"limits."
msgstr ""
"No hay una sesión de suscripción de Claude en %s. Las claves de API no "
"tienen límites de plan."

#: providers/anthropic.js:195
msgid ""
"The Claude Code sign-in has expired. Send a message in Claude Code to renew "
"it."
msgstr ""
"La sesión de Claude Code ha caducado. Envía un mensaje en Claude Code para "
"renovarla."

#: providers/anthropic.js:211
msgid ""
"Claude rejected the sign-in. Send a message in Claude Code to renew it."
msgstr ""
"Claude rechazó la sesión. Envía un mensaje en Claude Code para renovarla."

#: providers/anthropic.js:214
msgid "Too many requests. Retrying later."
msgstr "Demasiadas peticiones. Se reintentará más tarde."

#: providers/anthropic.js:216
#, javascript-format
msgid "Unexpected response from Claude (HTTP %d)."
msgstr "Respuesta inesperada de Claude (HTTP %d)."

#: providers/anthropic.js:220
msgid "Claude returned no usage data."
msgstr "Claude no devolvió datos de uso."

#. metadata.json->name
msgid "AI Usage Limits"
msgstr "Límites de uso de IA"

#. metadata.json->description
msgid ""
"Shows the usage limits of your AI subscriptions (Claude) in the panel, with "
"time until they reset."
msgstr ""
"Muestra en el panel los límites de uso de tus suscripciones de IA (Claude) y"
" cuánto falta para que se restablezcan."

#. settings-schema.json->general-page->title
msgid "General"
msgstr "General"

#. settings-schema.json->providers-page->title
msgid "Providers"
msgstr "Proveedores"

#. settings-schema.json->panel-section->title
msgid "Panel"
msgstr "Panel"

#. settings-schema.json->refresh-section->title
msgid "Updates"
msgstr "Actualizaciones"

#. settings-schema.json->alerts-section->title
msgid "Alerts"
msgstr "Avisos"

#. settings-schema.json->anthropic-section->title
msgid "Claude (Anthropic)"
msgstr "Claude (Anthropic)"

#. settings-schema.json->panel-display->description
msgid "Panel text"
msgstr "Texto del panel"

#. settings-schema.json->panel-display->options
msgid "Highest usage"
msgstr "Uso más alto"

#. settings-schema.json->panel-display->options
msgid "Main limit of each provider"
msgstr "Límite principal de cada proveedor"

#. settings-schema.json->panel-display->options
msgid "All limits"
msgstr "Todos los límites"

#. settings-schema.json->panel-display->options
msgid "Icon only"
msgstr "Solo el icono"

#. settings-schema.json->panel-display->tooltip
msgid ""
"Which percentages to show next to the icon. The menu always shows every "
"limit."
msgstr ""
"Qué porcentajes mostrar junto al icono. El menú siempre muestra todos los "
"límites."

#. settings-schema.json->show-reset-in-panel->description
msgid "Show time until reset in the panel"
msgstr "Mostrar en el panel el tiempo hasta el restablecimiento"

#. settings-schema.json->show-reset-in-panel->tooltip
msgid "Only shown when the panel displays a single limit."
msgstr "Solo se muestra cuando el panel enseña un único límite."

#. settings-schema.json->show-extra-usage->description
msgid "Show extra usage spending in the menu"
msgstr "Mostrar en el menú el gasto en uso adicional"

#. settings-schema.json->show-extra-usage->tooltip
msgid ""
"Pay-as-you-go credits used after the plan limits are reached, when your plan"
" has them enabled."
msgstr ""
"Créditos de pago por uso consumidos al alcanzar los límites del plan, si tu "
"plan los tiene activados."

#. settings-schema.json->refresh-interval->units
msgid "minutes"
msgstr "minutos"

#. settings-schema.json->refresh-interval->description
msgid "Refresh every"
msgstr "Actualizar cada"

#. settings-schema.json->warning-threshold->units
#. settings-schema.json->critical-threshold->units
msgid "%"
msgstr "%"

#. settings-schema.json->warning-threshold->description
msgid "Warning level"
msgstr "Nivel de aviso"

#. settings-schema.json->critical-threshold->description
msgid "Critical level"
msgstr "Nivel crítico"

#. settings-schema.json->notify-critical->description
msgid "Send a notification when a limit reaches the critical level"
msgstr "Enviar una notificación cuando un límite alcance el nivel crítico"

#. settings-schema.json->anthropic-enabled->description
msgid "Show Claude usage"
msgstr "Mostrar el uso de Claude"

#. settings-schema.json->anthropic-credentials-path->description
msgid "Claude Code credentials file"
msgstr "Archivo de credenciales de Claude Code"

#. settings-schema.json->anthropic-credentials-path->tooltip
msgid ""
"Leave empty to use $CLAUDE_CONFIG_DIR/.credentials.json or "
"~/.claude/.credentials.json."
msgstr ""
"Déjalo vacío para usar $CLAUDE_CONFIG_DIR/.credentials.json o "
"~/.claude/.credentials.json."

#. settings-schema.json->anthropic-help->description
msgid ""
"Uses the sign-in stored by Claude Code. It is read only and never sent "
"anywhere except api.anthropic.com."
msgstr ""
"Usa la sesión guardada por Claude Code. Solo se lee y nunca se envía a "
"ningún sitio salvo a api.anthropic.com."
