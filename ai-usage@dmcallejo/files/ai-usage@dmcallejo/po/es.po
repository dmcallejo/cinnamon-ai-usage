msgstr "Actualizado a las %s"

#: applet.js:590 applet.js:600
msgid "Automatic"
msgstr "Automático"

#: applet.js:591 applet.js:598
msgid "Most recent activity"
msgstr "Actividad más reciente"

#: applet.js:598
#, javascript-format
msgid "Most recent activity (%s)"
msgstr "Actividad más reciente (%s)"

#: applet.js:601
#, javascript-format
msgid "Panel shows: %s"
msgstr "El panel muestra: %s"

#: applet.js:671
#, javascript-format
