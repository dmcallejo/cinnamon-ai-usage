msgstr "%s: %s, se restablece en %s"

#: applet.js:388
msgid "All providers are turned off in the applet settings."
msgstr ""
"Todos los proveedores están desactivados en la configuración del applet."

#: applet.js:389
msgid ""
"No sign-in found. Sign in to Claude Code or the Codex CLI, then the applet "
"picks it up automatically."
msgstr ""
"No se encontró ninguna sesión. Inicia sesión en Claude Code o en la CLI de "
"Codex y el applet la detectará automáticamente."

#: applet.js:404
#, javascript-format
msgid "%s (%s plan)"
msgstr "%s (plan %s)"

