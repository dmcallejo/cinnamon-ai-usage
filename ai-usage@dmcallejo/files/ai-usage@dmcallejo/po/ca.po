#. settings-schema.json->anthropic-accounts->description
#. settings-schema.json->codex-accounts->description
#. settings-schema.json->kimi-accounts->description
msgid "Other accounts"
msgstr "Altres comptes"

#. settings-schema.json->panel-display->description
msgid "Panel text"
msgstr "Text del quadre"

#. settings-schema.json->panel-display->options
msgid "Highest limit"
msgstr "Límit més alt"

#. settings-schema.json->panel-display->options
msgid "Main limit"
msgstr "Límit principal"

#. settings-schema.json->panel-display->options
msgid "All limits"
msgstr "Tots els límits"

#. settings-schema.json->panel-display->options
msgid "Icon only"
msgstr "Només la icona"

#. settings-schema.json->panel-display->tooltip
msgid ""
"Which limits to show next to each provider icon. Which providers appear is "
"chosen in the menu, under \"Panel shows\". The menu always shows every "
"limit."
msgstr ""
"Quins límits es mostren al costat de la icona de cada proveïdor. Quins "
"proveïdors apareixen es tria al menú, a «El quadre mostra». El menú sempre "
"mostra tots els límits."

#. settings-schema.json->show-reset-in-panel->description
msgid "Show time until reset in the panel"
msgstr "Mostra al quadre el temps fins al restabliment"

#. settings-schema.json->show-reset-in-panel->tooltip
msgid "Only shown when the panel displays a single limit."
msgstr "Només es mostra quan el quadre ensenya un únic límit."

#. settings-schema.json->show-extra-usage->description
msgid "Show extra usage spending in the menu"
msgstr "Mostra al menú la despesa en ús addicional"

#. settings-schema.json->show-extra-usage->tooltip
msgid ""
"Pay-as-you-go credits used after the plan limits are reached, when your plan"
" has them enabled."
msgstr ""
"Crèdits de pagament per ús consumits en arribar als límits del pla, si el "
"teu pla els té activats."

#. settings-schema.json->refresh-interval->units
msgid "minutes"
msgstr "minuts"

#. settings-schema.json->refresh-interval->description
msgid "Refresh every"
msgstr "Actualitza cada"

#. settings-schema.json->warning-threshold->units
#. settings-schema.json->critical-threshold->units
msgid "%"
msgstr "%"

#. settings-schema.json->warning-threshold->description
msgid "Warning level"
msgstr "Nivell d'avís"

#. settings-schema.json->critical-threshold->description
msgid "Critical level"
msgstr "Nivell crític"

#. settings-schema.json->notify-critical->description
msgid "Send a notification when a limit reaches the critical level"
msgstr "Envia una notificació quan un límit arribi al nivell crític"

#. settings-schema.json->anthropic-mode->description
msgid "Show Claude usage"
msgstr "Mostra l'ús de Claude"

#. settings-schema.json->anthropic-mode->options
#. settings-schema.json->codex-mode->options
#. settings-schema.json->kimi-mode->options
msgid "When signed in"
msgstr "Si hi ha sessió iniciada"

#. settings-schema.json->anthropic-mode->options
#. settings-schema.json->codex-mode->options
#. settings-schema.json->kimi-mode->options
msgid "Always"
msgstr "Sempre"

#. settings-schema.json->anthropic-mode->options
#. settings-schema.json->codex-mode->options
#. settings-schema.json->kimi-mode->options
msgid "Never"
msgstr "Mai"

#. settings-schema.json->anthropic-mode->tooltip
msgid "\"When signed in\" shows Claude only if a Claude Code sign-in is found."
msgstr ""
"«Si hi ha sessió iniciada» mostra Claude només si es troba una sessió de "
"Claude Code."

#. settings-schema.json->anthropic-credentials-path->description
msgid "Claude Code credentials file"
msgstr "Fitxer de credencials de Claude Code"

#. settings-schema.json->anthropic-credentials-path->tooltip
msgid ""
"Leave empty to use $CLAUDE_CONFIG_DIR/.credentials.json or "
"~/.claude/.credentials.json."
msgstr ""
"Deixa-ho buit per utilitzar $CLAUDE_CONFIG_DIR/.credentials.json o "
"~/.claude/.credentials.json."

#. settings-schema.json->anthropic-icon->description
#. settings-schema.json->codex-icon->description
#. settings-schema.json->kimi-icon->description
#. settings-schema.json->anthropic-accounts->columns->title
#. settings-schema.json->codex-accounts->columns->title
#. settings-schema.json->kimi-accounts->columns->title
msgid "Panel icon"
msgstr "Icona del quadre"

#. settings-schema.json->anthropic-icon->tooltip
msgid ""
"Leave empty to use the built-in Claude symbol. You can choose any icon or "
"image file instead."
msgstr ""
"Deixa-ho buit per utilitzar el símbol de Claude inclòs. Pots triar qualsevol"
" icona o imatge en lloc seu."

#. settings-schema.json->anthropic-help->description
msgid ""
"Uses the sign-in stored by Claude Code. It is read only and never sent "
"anywhere except api.anthropic.com."
msgstr ""
"Utilitza la sessió desada per Claude Code. Només es llegeix i mai no s'envia"
" enlloc excepte a api.anthropic.com."

#. settings-schema.json->codex-mode->description
msgid "Show Codex usage"
msgstr "Mostra l'ús de Codex"

#. settings-schema.json->codex-mode->tooltip
msgid ""
"\"When signed in\" shows Codex only if a Codex CLI sign-in is found. These "
"are the Codex limits of your ChatGPT plan; ChatGPT chat message limits are "
"not available."
msgstr ""
"«Si hi ha sessió iniciada» mostra Codex només si es troba una sessió de la "
"CLI de Codex. Són els límits de Codex del teu pla de ChatGPT; els límits de "
"missatges del xat de ChatGPT no estan disponibles."

#. settings-schema.json->codex-auth-path->description
msgid "Codex CLI credentials file"
msgstr "Fitxer de credencials de la CLI de Codex"

#. settings-schema.json->codex-auth-path->tooltip
msgid "Leave empty to use $CODEX_HOME/auth.json or ~/.codex/auth.json."
msgstr ""
"Deixa-ho buit per utilitzar $CODEX_HOME/auth.json o ~/.codex/auth.json."

#. settings-schema.json->codex-icon->tooltip
msgid ""
"Leave empty to use the built-in Codex symbol. You can choose any icon or "
"image file instead."
msgstr ""
"Deixa-ho buit per utilitzar el símbol de Codex inclòs. Pots triar qualsevol "
"icona o imatge en lloc seu."

#. settings-schema.json->codex-help->description
msgid ""
"Uses the sign-in stored by the Codex CLI. It is read only and never sent "
"anywhere except chatgpt.com."
msgstr ""
"Utilitza la sessió desada per la CLI de Codex. Només es llegeix i mai no "
"s'envia enlloc excepte a chatgpt.com."

#. settings-schema.json->kimi-mode->description
msgid "Show Kimi usage"
msgstr "Mostra l'ús de Kimi"

#. settings-schema.json->kimi-mode->tooltip
msgid "\"When signed in\" shows Kimi only if a Kimi Code sign-in is found."
msgstr ""
"«Si hi ha sessió iniciada» mostra Kimi només si es troba una sessió de Kimi "
"Code."

#. settings-schema.json->kimi-icon->tooltip
msgid ""
"Leave empty to use the built-in Kimi symbol. You can choose any icon or "
"image file instead."
msgstr ""
"Deixa-ho buit per utilitzar el símbol de Kimi inclòs. Pots triar qualsevol "
"icona o imatge en lloc seu."

#. settings-schema.json->kimi-credentials-path->description
msgid "Kimi Code credentials file"
msgstr "Fitxer de credencials de Kimi Code"

#. settings-schema.json->kimi-credentials-path->tooltip
msgid "Leave empty to use the file named in Kimi Code's config.toml."
msgstr ""
"Deixa-ho buit per utilitzar el fitxer indicat al config.toml de Kimi Code."

#. settings-schema.json->kimi-help->description
msgid ""
"Uses the sign-in stored by Kimi Code. It is read only and never sent "
"anywhere except api.kimi.com or api.kimi.ai."
msgstr ""
"Utilitza la sessió desada per Kimi Code. Només es llegeix i mai no s'envia "
"enlloc excepte a api.kimi.com o api.kimi.ai."

#. settings-schema.json->anthropic-accounts-help->description
msgid ""
"Add an account that Claude Code keeps in its own folder (set with "
"CLAUDE_CONFIG_DIR). The folder is required."
msgstr ""
"Afegeix un compte que Claude Code desa a la seva pròpia carpeta (indicada "
"amb CLAUDE_CONFIG_DIR). La carpeta és obligatòria."

#. settings-schema.json->anthropic-accounts->columns->title
#. settings-schema.json->codex-accounts->columns->title
#. settings-schema.json->kimi-accounts->columns->title
msgid "Name"
msgstr "Nom"

#. settings-schema.json->anthropic-accounts->columns->title
#. settings-schema.json->codex-accounts->columns->title
#. settings-schema.json->kimi-accounts->columns->title
msgid "Sign-in folder"
msgstr "Carpeta de la sessió"

#. settings-schema.json->anthropic-accounts->columns->title
#. settings-schema.json->codex-accounts->columns->title
#. settings-schema.json->kimi-accounts->columns->title
msgid "Enabled"
msgstr "Activat"

#. settings-schema.json->codex-accounts-help->description
msgid ""
"Add an account that the Codex CLI keeps in its own folder (set with "
"CODEX_HOME). The folder is required."
msgstr ""
"Afegeix un compte que la CLI de Codex desa a la seva pròpia carpeta "
"(indicada amb CODEX_HOME). La carpeta és obligatòria."

#. settings-schema.json->kimi-accounts-help->description
msgid ""
"Add an account that Kimi Code keeps in its own folder (set with "
"KIMI_CODE_HOME). The folder is required."
msgstr ""
"Afegeix un compte que Kimi Code desa a la seva pròpia carpeta (indicada amb "
"KIMI_CODE_HOME). La carpeta és obligatòria."
