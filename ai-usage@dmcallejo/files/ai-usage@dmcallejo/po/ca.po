msgstr ""
"No hi ha cap proveïdor activat. Activa'n un a la configuració de la "
"miniaplicació."

#: applet.js:373
#, javascript-format
msgid "%s (%s plan)"
msgstr "%s (pla %s)"

#: applet.js:384
