#: applet.js:93
msgid "AI usage limits"
msgstr "Límits d'ús d'IA"

#: applet.js:103 applet.js:500
msgid "Refresh now"
msgstr "Actualitza ara"

#: applet.js:261
#, javascript-format
msgid "Could not reach %s. Check your connection."
msgstr "No s'ha pogut contactar amb %s. Comprova la connexió."

#: applet.js:309
#, javascript-format
msgid "Resets in %s (%s)"
msgstr "Es restableix en %s (%s)"

#: applet.js:436
#, javascript-format
msgid "%s: %s, resets in %s"
msgstr "%s: %s, es restableix en %s"

#: applet.js:450
msgid "All providers are turned off in the applet settings."
msgstr ""
"Tots els proveïdors estan desactivats a la configuració de la miniaplicació."

#: applet.js:451
msgid ""
"No sign-in found. Sign in to Claude Code, the Codex CLI or Kimi Code, then "
"the applet picks it up automatically."
msgstr ""
"No s'ha trobat cap sessió. Inicia sessió a Claude Code, a la CLI de Codex o "
"a Kimi Code i la miniaplicació la detectarà automàticament."

#: applet.js:466
#, javascript-format
msgid "%s (%s plan)"
msgstr "%s (pla %s)"

#: applet.js:477
#, javascript-format
msgid "%s of %s"
msgstr "%s de %s"

#: applet.js:483
msgid "Loading..."
msgstr "S'està carregant..."

#: applet.js:489
#, javascript-format
msgid "Open %s usage page"
msgstr "Obre la pàgina d'ús de %s"

#: applet.js:498
#, javascript-format
msgid "Updated at %s"
msgstr "Actualitzat a les %s"

#: applet.js:557
#, javascript-format
msgid "%s: %s at %s"
msgstr "%s: %s al %s"

#: applet.js:558
#, javascript-format
msgid "Resets in %s."
msgstr "Es restableix en %s."

#: lib/util.js:38
msgid "now"
msgstr "ara"

#: lib/util.js:40
msgid "<1m"
msgstr "<1 min"

#: lib/util.js:42
#, javascript-format
msgid "%dm"
msgstr "%d min"

#: lib/util.js:46
#, javascript-format
msgid "%dh %sm"
msgstr "%d h %s min"

#: lib/util.js:50
#, javascript-format
msgid "%dd %dh"
msgstr "%d d %d h"

#: providers/anthropic.js:30
msgid "Current session"
msgstr "Sessió actual"

#: providers/anthropic.js:32
msgid "Weekly, all models"
msgstr "Setmanal, tots els models"

#: providers/anthropic.js:34
msgid "Weekly, Opus"
msgstr "Setmanal, Opus"

#: providers/anthropic.js:36
msgid "Weekly, Sonnet"
msgstr "Setmanal, Sonnet"

#: providers/anthropic.js:92 providers/anthropic.js:108 providers/kimi.js:161
msgid "Extra usage"
msgstr "Ús addicional"

#: providers/anthropic.js:186
#, javascript-format
msgid "No Claude Code sign-in found at %s. Sign in with Claude Code first."
msgstr ""
"No s'ha trobat cap sessió de Claude Code a %s. Inicia sessió primer amb "
"Claude Code."

#: providers/anthropic.js:189 providers/codex.js:149 providers/kimi.js:300
#, javascript-format
msgid "Could not parse %s."
msgstr "No s'ha pogut llegir %s."

#: providers/anthropic.js:196
#, javascript-format
msgid ""
"No Claude subscription sign-in found in %s. API keys do not have plan "
"limits."
msgstr ""
"No hi ha cap sessió de subscripció de Claude a %s. Les claus d'API no tenen "
"límits de pla."

#: providers/anthropic.js:200
msgid ""
"The Claude Code sign-in has expired. Send a message in Claude Code to renew "
"it."
msgstr ""
"La sessió de Claude Code ha caducat. Envia un missatge a Claude Code per "
"renovar-la."

#: providers/anthropic.js:216
msgid ""
"Claude rejected the sign-in. Send a message in Claude Code to renew it."
msgstr ""
"Claude ha rebutjat la sessió. Envia un missatge a Claude Code per renovar-"
"la."

#: providers/anthropic.js:219 providers/codex.js:178 providers/kimi.js:331
msgid "Too many requests. Retrying later."
msgstr "Massa peticions. Es tornarà a provar més tard."

#: providers/anthropic.js:221
#, javascript-format
msgid "Unexpected response from Claude (HTTP %d)."
msgstr "Resposta inesperada de Claude (HTTP %d)."

#: providers/anthropic.js:225
msgid "Claude returned no usage data."
msgstr "Claude no ha retornat dades d'ús."

#: providers/codex.js:26 providers/kimi.js:39
msgid "5-hour limit"
msgstr "Límit de 5 hores"

#: providers/codex.js:28 providers/kimi.js:41
msgid "Weekly limit"
msgstr "Límit setmanal"

#: providers/codex.js:30
#, javascript-format
msgid "%s limit"
msgstr "Límit de %s"

#: providers/codex.js:31 providers/kimi.js:47
msgid "Usage limit"
msgstr "Límit d'ús"

#: providers/codex.js:59
#, javascript-format
msgid "%s, %s"
msgstr "%s, %s"

#: providers/codex.js:72
msgid "Code review"
msgstr "Revisió de codi"

#: providers/codex.js:146
#, javascript-format
msgid "No Codex sign-in found at %s. Sign in with the Codex CLI first."
msgstr ""
"No s'ha trobat cap sessió de Codex a %s. Inicia sessió primer amb la CLI de "
"Codex."

#: providers/codex.js:156
#, javascript-format
msgid "No ChatGPT sign-in found in %s. API keys do not have plan limits."
msgstr ""
"No hi ha cap sessió de ChatGPT a %s. Les claus d'API no tenen límits de pla."

#: providers/codex.js:175
msgid "ChatGPT rejected the Codex sign-in. Run Codex to renew it."
msgstr "ChatGPT ha rebutjat la sessió de Codex. Executa Codex per renovar-la."

#: providers/codex.js:180
#, javascript-format
msgid "Unexpected response from Codex (HTTP %d)."
msgstr "Resposta inesperada de Codex (HTTP %d)."

#: providers/codex.js:184
msgid "Codex returned no usage data."
msgstr "Codex no ha retornat dades d'ús."

#: providers/kimi.js:43
msgid "Monthly, Kimi Code"
msgstr "Mensual, Kimi Code"

#: providers/kimi.js:45
msgid "Monthly, all Kimi usage"
msgstr "Mensual, tot l'ús de Kimi"

#: providers/kimi.js:297
#, javascript-format
msgid "No Kimi Code sign-in found at %s. Sign in with Kimi Code first."
msgstr ""
"No s'ha trobat cap sessió de Kimi Code a %s. Inicia sessió primer amb Kimi "
"Code."

#: providers/kimi.js:306
#, javascript-format
msgid "No Kimi Code sign-in found in %s."
msgstr "No hi ha cap sessió de Kimi Code a %s."

#: providers/kimi.js:314
msgid ""
"The Kimi Code sign-in has expired. Send a message in Kimi Code to renew it."
msgstr ""
"La sessió de Kimi Code ha caducat. Envia un missatge a Kimi Code per "
"renovar-la."

#: providers/kimi.js:328
msgid "Kimi rejected the sign-in. Send a message in Kimi Code to renew it."
msgstr ""
"Kimi ha rebutjat la sessió. Envia un missatge a Kimi Code per renovar-la."

#: providers/kimi.js:333
#, javascript-format
msgid "Unexpected response from Kimi (HTTP %d)."
msgstr "Resposta inesperada de Kimi (HTTP %d)."

#: providers/kimi.js:337 providers/kimi.js:341
msgid "Kimi returned no usage data."
msgstr "Kimi no ha retornat dades d'ús."

#. metadata.json->name
msgid "AI Usage Limits"
msgstr "Límits d'ús d'IA"

#. metadata.json->description
msgid ""
"Shows the usage limits of your AI subscriptions (Claude, Codex, Kimi) in the"
" panel, with time until they reset."
msgstr ""
"Mostra al quadre els límits d'ús de les teves subscripcions d'IA (Claude, "
"Codex, Kimi) i quant falta perquè es restableixin."

#. settings-schema.json->general-page->title
msgid "General"
msgstr "General"

#. settings-schema.json->providers-page->title
msgid "Providers"
msgstr "Proveïdors"

#. settings-schema.json->panel-section->title
msgid "Panel"
msgstr "Quadre"

#. settings-schema.json->refresh-section->title
msgid "Updates"
msgstr "Actualitzacions"

#. settings-schema.json->alerts-section->title
msgid "Alerts"
msgstr "Avisos"

#. settings-schema.json->anthropic-section->title
msgid "Claude (Anthropic)"
msgstr "Claude (Anthropic)"

#. settings-schema.json->codex-section->title
msgid "Codex (OpenAI)"
msgstr "Codex (OpenAI)"

#. settings-schema.json->kimi-section->title
msgid "Kimi Code (Moonshot AI)"
msgstr "Kimi Code (Moonshot AI)"

#. settings-schema.json->panel-display->description
msgid "Panel text"
msgstr "Text del quadre"

#. settings-schema.json->panel-display->options
msgid "Highest usage"
msgstr "Ús més alt"

#. settings-schema.json->panel-display->options
msgid "Main limit of each provider"
msgstr "Límit principal de cada proveïdor"

#. settings-schema.json->panel-display->options
msgid "All limits"
msgstr "Tots els límits"

#. settings-schema.json->panel-display->options
msgid "Icon only"
msgstr "Només la icona"

#. settings-schema.json->panel-display->tooltip
msgid ""
"Which percentages to show next to the icon. The menu always shows every "
"limit."
msgstr ""
"Quins percentatges es mostren al costat de la icona. El menú sempre mostra "
"tots els límits."

#. settings-schema.json->show-reset-in-panel->description
msgid "Show time until reset in the panel"
msgstr "Mostra al quadre el temps fins al restabliment"

#. settings-schema.json->show-reset-in-panel->tooltip
msgid "Only shown when the panel displays a single limit."
msgstr "Només es mostra quan el quadre ensenya un únic límit."

#. settings-schema.json->show-extra-usage->description
msgid "Show extra usage spending in the menu"
msgstr "Mostra al menú la despesa en ús addicional"

#. settings-schema.json->show-extra-usage->tooltip
msgid ""
"Pay-as-you-go credits used after the plan limits are reached, when your plan"
" has them enabled."
msgstr ""
"Crèdits de pagament per ús consumits en arribar als límits del pla, si el "
"teu pla els té activats."

#. settings-schema.json->refresh-interval->units
msgid "minutes"
msgstr "minuts"

#. settings-schema.json->refresh-interval->description
msgid "Refresh every"
msgstr "Actualitza cada"

#. settings-schema.json->warning-threshold->units
#. settings-schema.json->critical-threshold->units
msgid "%"
msgstr "%"

#. settings-schema.json->warning-threshold->description
msgid "Warning level"
msgstr "Nivell d'avís"

#. settings-schema.json->critical-threshold->description
msgid "Critical level"
msgstr "Nivell crític"

#. settings-schema.json->notify-critical->description
msgid "Send a notification when a limit reaches the critical level"
msgstr "Envia una notificació quan un límit arribi al nivell crític"

#. settings-schema.json->anthropic-mode->description
msgid "Show Claude usage"
msgstr "Mostra l'ús de Claude"

#. settings-schema.json->anthropic-mode->options
#. settings-schema.json->codex-mode->options
#. settings-schema.json->kimi-mode->options
msgid "When signed in"
msgstr "Si hi ha sessió iniciada"

#. settings-schema.json->anthropic-mode->options
#. settings-schema.json->codex-mode->options
#. settings-schema.json->kimi-mode->options
msgid "Always"
msgstr "Sempre"

#. settings-schema.json->anthropic-mode->options
#. settings-schema.json->codex-mode->options
#. settings-schema.json->kimi-mode->options
msgid "Never"
msgstr "Mai"

#. settings-schema.json->anthropic-mode->tooltip
msgid "\"When signed in\" shows Claude only if a Claude Code sign-in is found."
msgstr ""
"«Si hi ha sessió iniciada» mostra Claude només si es troba una sessió de "
"Claude Code."

#. settings-schema.json->anthropic-credentials-path->description
msgid "Claude Code credentials file"
msgstr "Fitxer de credencials de Claude Code"

#. settings-schema.json->anthropic-credentials-path->tooltip
msgid ""
"Leave empty to use $CLAUDE_CONFIG_DIR/.credentials.json or "
"~/.claude/.credentials.json."
msgstr ""
"Deixa-ho buit per utilitzar $CLAUDE_CONFIG_DIR/.credentials.json o "
"~/.claude/.credentials.json."

#. settings-schema.json->anthropic-icon->description
#. settings-schema.json->codex-icon->description
#. settings-schema.json->kimi-icon->description
msgid "Panel icon"
msgstr "Icona del quadre"

#. settings-schema.json->anthropic-icon->tooltip
msgid ""
"Leave empty to use the built-in Claude symbol. You can choose any icon or "
"image file instead."
msgstr ""
"Deixa-ho buit per utilitzar el símbol de Claude inclòs. Pots triar qualsevol"
" icona o imatge en lloc seu."

#. settings-schema.json->anthropic-help->description
msgid ""
"Uses the sign-in stored by Claude Code. It is read only and never sent "
"anywhere except api.anthropic.com."
msgstr ""
"Utilitza la sessió desada per Claude Code. Només es llegeix i mai no s'envia"
" enlloc excepte a api.anthropic.com."

#. settings-schema.json->codex-mode->description
msgid "Show Codex usage"
msgstr "Mostra l'ús de Codex"

#. settings-schema.json->codex-mode->tooltip
msgid ""
"\"When signed in\" shows Codex only if a Codex CLI sign-in is found. These "
"are the Codex limits of your ChatGPT plan; ChatGPT chat message limits are "
"not available."
msgstr ""
"«Si hi ha sessió iniciada» mostra Codex només si es troba una sessió de la "
"CLI de Codex. Són els límits de Codex del teu pla de ChatGPT; els límits de "
"missatges del xat de ChatGPT no estan disponibles."

#. settings-schema.json->codex-auth-path->description
msgid "Codex CLI credentials file"
msgstr "Fitxer de credencials de la CLI de Codex"

#. settings-schema.json->codex-auth-path->tooltip
msgid "Leave empty to use $CODEX_HOME/auth.json or ~/.codex/auth.json."
msgstr ""
"Deixa-ho buit per utilitzar $CODEX_HOME/auth.json o ~/.codex/auth.json."

#. settings-schema.json->codex-icon->tooltip
msgid ""
"Leave empty to use the built-in Codex symbol. You can choose any icon or "
"image file instead."
msgstr ""
"Deixa-ho buit per utilitzar el símbol de Codex inclòs. Pots triar qualsevol "
"icona o imatge en lloc seu."

#. settings-schema.json->codex-help->description
msgid ""
"Uses the sign-in stored by the Codex CLI. It is read only and never sent "
"anywhere except chatgpt.com."
msgstr ""
"Utilitza la sessió desada per la CLI de Codex. Només es llegeix i mai no "
"s'envia enlloc excepte a chatgpt.com."

#. settings-schema.json->kimi-mode->description
msgid "Show Kimi usage"
msgstr "Mostra l'ús de Kimi"

#. settings-schema.json->kimi-mode->tooltip
msgid "\"When signed in\" shows Kimi only if a Kimi Code sign-in is found."
msgstr ""
"«Si hi ha sessió iniciada» mostra Kimi només si es troba una sessió de Kimi "
"Code."

#. settings-schema.json->kimi-icon->tooltip
msgid ""
"Leave empty to use the built-in Kimi symbol. You can choose any icon or "
"image file instead."
msgstr ""
"Deixa-ho buit per utilitzar el símbol de Kimi inclòs. Pots triar qualsevol "
"icona o imatge en lloc seu."

#. settings-schema.json->kimi-credentials-path->description
msgid "Kimi Code credentials file"
msgstr "Fitxer de credencials de Kimi Code"

#. settings-schema.json->kimi-credentials-path->tooltip
msgid "Leave empty to use the file named in Kimi Code's config.toml."
msgstr ""
"Deixa-ho buit per utilitzar el fitxer indicat al config.toml de Kimi Code."

#. settings-schema.json->kimi-help->description
msgid ""
"Uses the sign-in stored by Kimi Code. It is read only and never sent "
"anywhere except api.kimi.com or api.kimi.ai."
msgstr ""
"Utilitza la sessió desada per Kimi Code. Només es llegeix i mai no s'envia "
"enlloc excepte a api.kimi.com o api.kimi.ai."

