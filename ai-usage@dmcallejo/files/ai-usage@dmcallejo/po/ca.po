#, javascript-format
msgid ""
"No Claude subscription sign-in found in %s. API keys do not have plan "
"limits."
msgstr ""
"No hi ha cap sessió de subscripció de Claude a %s. Les claus d'API no tenen "
"límits de pla."

#: providers/anthropic.js:206
msgid ""
"The Claude Code sign-in has expired. Send a message in Claude Code to renew "
"it."
msgstr ""
"La sessió de Claude Code ha caducat. Envia un missatge a Claude Code per "
"renovar-la."

#: providers/anthropic.js:222
msgid ""
"Claude rejected the sign-in. Send a message in Claude Code to renew it."
msgstr ""
"Claude ha rebutjat la sessió. Envia un missatge a Claude Code per renovar-"
"la."

#: providers/anthropic.js:225 providers/codex.js:186 providers/kimi.js:337
msgid "Too many requests. Retrying later."
msgstr "Massa peticions. Es tornarà a provar més tard."

#: providers/anthropic.js:227
#, javascript-format
msgid "Unexpected response from Claude (HTTP %d)."
msgstr "Resposta inesperada de Claude (HTTP %d)."

#: providers/anthropic.js:231
msgid "Claude returned no usage data."
msgstr "Claude no ha retornat dades d'ús."

