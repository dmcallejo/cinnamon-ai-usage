#, javascript-format
msgid "No Codex sign-in found at %s. Sign in with the Codex CLI first."
msgstr ""
"No s'ha trobat cap sessió de Codex a %s. Inicia sessió primer amb la CLI de "
"Codex."

#: providers/codex.js:164
#, javascript-format
msgid "No ChatGPT sign-in found in %s. API keys do not have plan limits."
msgstr ""
"No hi ha cap sessió de ChatGPT a %s. Les claus d'API no tenen límits de pla."

#: providers/codex.js:183
msgid "ChatGPT rejected the Codex sign-in. Run Codex to renew it."
msgstr "ChatGPT ha rebutjat la sessió de Codex. Executa Codex per renovar-la."

#: providers/codex.js:188
#, javascript-format
msgid "Unexpected response from Codex (HTTP %d)."
msgstr "Resposta inesperada de Codex (HTTP %d)."

#: providers/codex.js:192
msgid "Codex returned no usage data."
msgstr "Codex no ha retornat dades d'ús."

#: providers/kimi.js:43
msgid "Monthly, Kimi Code"
msgstr "Mensual, Kimi Code"

#: providers/kimi.js:45
msgid "Monthly, all Kimi usage"
msgstr "Mensual, tot l'ús de Kimi"

#: providers/kimi.js:303
#, javascript-format
msgid "No Kimi Code sign-in found at %s. Sign in with Kimi Code first."
msgstr ""
"No s'ha trobat cap sessió de Kimi Code a %s. Inicia sessió primer amb Kimi "
"Code."

#: providers/kimi.js:312
#, javascript-format
msgid "No Kimi Code sign-in found in %s."
msgstr "No hi ha cap sessió de Kimi Code a %s."

#: providers/kimi.js:320
msgid ""
"The Kimi Code sign-in has expired. Send a message in Kimi Code to renew it."
msgstr ""
"La sessió de Kimi Code ha caducat. Envia un missatge a Kimi Code per "
"renovar-la."

#: providers/kimi.js:334
msgid "Kimi rejected the sign-in. Send a message in Kimi Code to renew it."
msgstr ""
"Kimi ha rebutjat la sessió. Envia un missatge a Kimi Code per renovar-la."

#: providers/kimi.js:339
#, javascript-format
msgid "Unexpected response from Kimi (HTTP %d)."
msgstr "Resposta inesperada de Kimi (HTTP %d)."

#: providers/kimi.js:343 providers/kimi.js:347
msgid "Kimi returned no usage data."
msgstr "Kimi no ha retornat dades d'ús."

#. metadata.json->name
msgid "AI Usage Limits"
msgstr "Límits d'ús d'IA"

#. metadata.json->description
msgid ""
"Shows the usage limits of your AI subscriptions (Claude, Codex, Kimi) in the"
" panel, with time until they reset."
msgstr ""
"Mostra al quadre els límits d'ús de les teves subscripcions d'IA (Claude, "
"Codex, Kimi) i quant falta perquè es restableixin."

